{
  "name": "@fenix/web",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm run check && vite build",
    "check": "tsc --noEmit && tsc -p tsconfig.strict.json --noEmit",
    "format:check": "prettier --check src index.html vite.config.ts tsconfig*.json playwright.config.js tests/*.js package.json",
    "test": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.13.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "3.9.6",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  },
  "packageManager": "pnpm@10.34.5",
  "dependencies": {
    "dompurify": "^3.4.15",
    "marked": "16.4.2",
    "mermaid": "^11.17.2",
    "pdfjs-dist": "6.3.289",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.18.4"
  }
}
