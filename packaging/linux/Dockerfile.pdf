# Lightweight PDF manipulation image; optionally use the CPU OCR image as base.
# Build from repository root with an approved immutable tenant image.
ARG FENIX_TENANT_IMAGE
FROM ${FENIX_TENANT_IMAGE}
USER root
RUN apt-get update && apt-get install -y --no-install-recommends python3-venv fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*
COPY resources/skills/pdf-workflows/scripts/requirements.txt /opt/fenix-pdf-requirements.txt
RUN python3 -m venv /opt/fenix-pdf \
    && /opt/fenix-pdf/bin/pip install --no-cache-dir -r /opt/fenix-pdf-requirements.txt \
    && chmod -R a+rX,go-w /opt/fenix-pdf
# The broker supplies the non-root identity and mounts selected skill resources.
