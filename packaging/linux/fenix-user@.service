[Unit]
Description=Fenix isolated runtime for account %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
# Legacy user-unit compatibility. New deployments use the system
# fenix-controller@.service with BindsTo=fenix-execution.service.
ExecStartPre=/usr/bin/sudo -n /usr/bin/python3 /opt/fenix/isolation/tenant-preflight.py /etc/fenix/execution.json %i
ExecStart=/usr/bin/docker start --attach fenix-user-%i
ExecStop=/usr/bin/docker stop --time 20 fenix-user-%i
Restart=always
RestartSec=5
TimeoutStopSec=40
UMask=0077

[Install]
WantedBy=default.target
