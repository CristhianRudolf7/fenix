[Unit]
Description=Fenix local personal assistant
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/bin/fenix --data-dir %h/.local/share/fenix/.fenix
WorkingDirectory=%h/.local/share/fenix
Environment=FENIX_WEB_DIST=%h/.local/share/fenix/web
EnvironmentFile=-%h/.config/fenix/server.env
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=default.target
