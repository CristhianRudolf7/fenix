[Unit]
Description=Fenix isolated account controller %i
After=fenix-execution.service docker.service
Requires=fenix-execution.service docker.service
BindsTo=fenix-execution.service

[Service]
Type=simple
ExecStartPre=/usr/bin/python3 /opt/fenix/isolation/tenant-preflight.py /etc/fenix/execution.json %i
ExecStart=/usr/bin/docker start --attach fenix-user-%i
ExecStop=/usr/bin/docker stop --time 20 fenix-user-%i
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
UMask=0077

[Install]
WantedBy=multi-user.target
